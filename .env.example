# Required: API key for the configured Anthropic-compatible endpoint
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# Optional: model name (defaults to deepseek-v4-flash)
# LLM_MODEL=deepseek-v4-flash

# Optional: Anthropic-compatible base URL
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: web server bind (defaults to 127.0.0.1:8000)
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
